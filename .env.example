# --- Database (local docker by default; for Supabase use the session-pooler URI from Project Settings → Database)
DATABASE_URL=postgresql://scout:scout@localhost:54329/scout

# --- Providers (swappable). LLM_PROVIDER: anthropic | openai | fake.  EMBEDDING_PROVIDER: openai | fake
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_INPUT_USD_PER_MTOK=0.10
LLM_OUTPUT_USD_PER_MTOK=0.50
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# --- Sources (all optional; connectors without credentials are skipped, never fail)
GITHUB_TOKEN=          # raises GitHub rate limit from 60 to 5000 req/h
XAI_API_KEY=           # X monitoring via Grok's X-search tool (console.x.ai). Shared X links work without it.
XAI_MODEL=grok-4-fast
HF_TOKEN=

# --- Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=              # makes slash commands appear instantly
DISCORD_LINKS_CHANNEL_ID=      # the one channel the bot watches for links
DISCORD_ALERTS_CHANNEL_ID=     # high-relevance alerts, health, weekly digest
DISCORD_DIGEST_CHANNEL_ID=     # optional, defaults to alerts channel
DISCORD_ALERTS_WEBHOOK_URL=    # lets the GitHub Actions cron post health alerts

# --- MCP over HTTP
MCP_BEARER_TOKEN=              # generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_PORT=8765

# --- Tuning
ALERT_MIN_RELEVANCE=0.75
DEDUPE_SIMILARITY=0.92
LOOKBACK_DAYS=2
