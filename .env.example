# Runs fully locally: Postgres in docker, embeddings on CPU. You need ANTHROPIC_API_KEY; everything else is optional.

# --- Database (local docker from `make db`). Any Postgres with pgvector works, e.g. Supabase's session-pooler URI.
DATABASE_URL=postgresql://scout:scout@localhost:54329/scout

# --- LLM (enrichment, @Scout questions, brief). LLM_PROVIDER: anthropic | fake
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_INPUT_USD_PER_MTOK=0.10
LLM_OUTPUT_USD_PER_MTOK=0.50
ANTHROPIC_API_KEY=

# --- Embeddings. local = fastembed on CPU, no key (default) | fake
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Sources (all optional: connectors without credentials are skipped, never failed)
X_API_KEY=                     # X app consumer key + secret (exchanged for an app-only bearer token), or:
X_API_SECRET=
X_BEARER_TOKEN=                # ...an app bearer token directly. Shared X links work without any X key.
X_MAX_RESULTS=100              # max posts read per query per scan: caps credit spend
X_EVERY_HOURS=2                # scan X this often
BRIEF_HOUR=9                   # the daily brief posts at this local hour (everything kept since the last one)
BRIEF_TZ=Australia/Sydney
DAILY_BRIEF=true               # false: only /scan posts a brief
GITHUB_TOKEN=                  # raises GitHub's rate limit from 60 to 5000 req/h (a fine-grained token, no scopes)
HF_TOKEN=

# --- Discord: the bot monitors every source and posts a short feed; team links get a 4-bullet reply
DISCORD_TOKEN=
DISCORD_LINKS_CHANNEL_ID=      # the one channel the team drops links in
DISCORD_FEED_CHANNEL_ID=       # where the monitoring feed is posted
DISCORD_ALERTS_WEBHOOK_URL=    # optional: lets the GitHub cron post health problems without the bot

# --- MCP over HTTP (only for hosted use; local clients use stdio)
MCP_BEARER_TOKEN=
MCP_PORT=8765

# --- Tuning
ALERT_MIN_RELEVANCE=0.75       # 🔥 highlight in the feed
DEDUPE_SIMILARITY=0.92
LOOKBACK_DAYS=2
